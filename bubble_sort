#include<stdio.h>
#include<stdlib.h>
void bubble_sort(int list[20],int list_count){
    int temp;
    for(int i=0;i<list_count-1;i++){
        for(int j=0;j<list_count-i-1;j++){
            if(list[j] > list[j+1]){
                temp = list[j];
                list[j] = list[j+1];
                list[j+1] = temp;
            }
        }
    }
}
void main(){

    //Declaration of variables    
    int n,numbers[20],i;

    //Read input array from user
    printf("No of elements \n");
    scanf("%d",&n);
    printf("elements \n");
    for(i=0;i<n;i++){
        scanf("%d",&numbers[i]);
    }

    //Call bubblesort function
    bubble_sort(numbers,n);
    
    //Print the sorted Array
    for(i=0;i<n;i++){
        printf("%d ",numbers[i]);
    }

}
